<main class="chat-shell">
  <aside class="chat-aside">
    <%= link_to "All dialogs", conversation_sessions_path, class: "back-link" %>

    <div class="chat-meta">
      <h1><%= @conversation_session.display_title %></h1>
      <% if @conversation_session.topic.present? || @conversation_session.level.present? %>
        <p><%= [@conversation_session.topic, @conversation_session.level].compact_blank.join(" · ") %></p>
      <% end %>
    </div>
  </aside>

  <section class="chat-panel" data-controller="assistant-audio">
    <div class="messages" id="messages">
      <% if @messages.any? %>
        <% latest_assistant_audio_message = @messages.reverse.find { |message| message.assistant? && message.audio.attached? } %>
        <%= render partial: "messages/message", collection: @messages, locals: { latest_assistant_audio_message: latest_assistant_audio_message } %>
      <% else %>
        <div class="empty-state" id="empty_messages_state">
          <h2>Start the conversation</h2>
          <p>Write or record in English. The assistant will answer and add a short coaching note.</p>
        </div>
      <% end %>
    </div>

    <%= render "messages/form", conversation_session: @conversation_session, message: @message %>
  </section>
</main>
