<main class="chat-shell">
  <aside class="chat-aside">
    <%= link_to "All dialogs", conversation_sessions_path, class: "back-link" %>

    <div class="chat-meta">
      <h1><%= @conversation_session.display_title %></h1>
      <% if @conversation_session.topic.present? || @conversation_session.level.present? %>
        <p><%= [@conversation_session.topic, @conversation_session.level].compact_blank.join(" · ") %></p>
      <% end %>
    </div>
  </aside>

  <section class="chat-panel" data-controller="assistant-audio">
    <div class="messages" id="messages">
      <% if @messages.any? %>
        <% latest_assistant_audio_message = @messages.reverse.find { |message| message.assistant? && message.audio.attached? } %>
        <%= render partial: "messages/message", collection: @messages, locals: { latest_assistant_audio_message: latest_assistant_audio_message } %>
      <% else %>
        <div class="empty-state">
          <h2>Start the conversation</h2>
          <p>Write or record in English. The assistant will answer and add a short coaching note.</p>
        </div>
      <% end %>
    </div>

    <%= form_with model: [@conversation_session, @message], class: "message-form", data: { controller: "audio-recorder" } do |form| %>
      <%= form.text_area :content, rows: 3, required: true, autofocus: true, placeholder: "Type your English message...", data: { audio_recorder_target: "textArea" } %>
      <%= form.file_field :audio, accept: "audio/wav,audio/mpeg,audio/mp4,audio/webm", class: "visually-hidden", data: { audio_recorder_target: "fileInput" } %>

      <div class="message-actions">
        <button type="button" class="secondary-button" data-action="audio-recorder#toggle" data-audio-recorder-target="recordButton">Record</button>
        <%= form.submit "Send", class: "primary-button" %>
      </div>

      <div class="recorder-status" data-audio-recorder-target="status" aria-live="polite"></div>
    <% end %>
  </section>
</main>
